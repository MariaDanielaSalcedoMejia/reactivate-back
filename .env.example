# Copiar este archivo a `.env` y completar con tus valores

# PostgreSQL Database URL
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_base_datos
# Ejemplos:
#   Desarrollo local: postgresql://postgres:postgres@localhost:5432/reactivate_pro
#   Render: postgresql://user:xxxxx@dpg-xxxx.render.com:5432/reactivate_pro
DATABASE_URL=postgresql://user:password@host:5432/database_name

# Entorno (development, testing, production)
ENV=development
